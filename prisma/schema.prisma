datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  // Loads nested relations in one SQL statement (LATERAL joins) instead of a query per relation
  // level, and applies nested `take` in the database rather than after fetching every row
  previewFeatures = ["relationJoins"]
}

enum RequestStatus {
  ACTIVE
  DONE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  REQUEST_ATTACHMENT
  INVENTORY_ATTACHMENT
  SYSTEM
}

model User {
  id                    String              @id @default(uuid())
  fullName              String
  businessName          String?
  shopAddress           String?
  // The market the vendor trades in; they only see requests from, and are only notified by,
  // people in the same market. Null on accounts made before markets existed
  marketId              String?
  market                Market?             @relation(fields: [marketId], references: [id], onDelete: Restrict)
  email                 String              @unique
  phoneNumber           String              @unique
  passwordHash          String
  avatarUrl             String?
  // Photos of the vendor's plaza and of their office, shown on their profile to other vendors
  plazaImageUrl         String?
  officeImageUrl        String?
  subscriptionPlan      String              @default("Free")
  bachsCustomerId       String?
  paystackCustomerId    String?
  isVerified            Boolean             @default(false)
  verificationStatus    VerificationStatus  @default(UNVERIFIED)
  cacRegistrationNumber String?
  teamOwnerId           String?
  teamOwner             User?               @relation("TeamMembers", fields: [teamOwnerId], references: [id], onDelete: SetNull)
  teamMembers           User[]              @relation("TeamMembers")
  cacSharedByOwnerName  String?
  cacSharedByBusinessName String?
  fcmToken              String?
  notificationsEnabled  Boolean             @default(true)
  lastSeenAt            DateTime?
  // Set when the user deletes their account. The row stays, scrubbed of personal details, so
  // the people they chatted with keep the conversation
  deletedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  requests              Request[]           @relation("UserRequests")
  fulfilledRequests     Request[]           @relation("FulfilledRequests")
  interests             RequestInterest[]
  chatThreadsAsUser     ChatThread[]        @relation("UserThreads")
  chatThreadsAsVendor   ChatThread[]        @relation("VendorThreads")
  messages              Message[]
  inventoryItems        InventoryItem[]
  teamInvitesSent       TeamInvite[]        @relation("SentInvites")
  notifications         Notification[]
  feedbacks             Feedback[]
  subscription          Subscription?
  subscriptionTransactions SubscriptionTransaction[]
  blocksInitiated       BlockedVendor[]     @relation("BlocksInitiated")
  blocksReceived        BlockedVendor[]     @relation("BlocksReceived")

  @@index([email])
  @@index([phoneNumber])
  @@index([createdAt])
  @@index([marketId])
}

// A trading market (e.g. a plaza or area) vendors pick at signup. Managed in the admin panel;
// one with users in it can't be deleted
model Market {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
}

model OtpVerification {
  id          String   @id @default(uuid())
  destination String   // Email or Phone number
  code        String   // 6-digit OTP
  purpose     String   // "signup", "password_reset"
  expiresAt   DateTime
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([destination, purpose])
}

model TeamInvite {
  id           String   @id @default(uuid())
  inviterId    String
  inviter      User     @relation("SentInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeEmail String
  createdAt    DateTime @default(now())

  @@unique([inviterId, inviteeEmail])
  @@index([inviterId])
}

model Request {
  id                    String            @id @default(uuid())
  title                 String
  status                RequestStatus     @default(ACTIVE)
  isDeleted             Boolean           @default(false)
  requesterId           String
  requester             User              @relation("UserRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  chosenVendorId        String?
  fulfilledByVendorId   String?
  fulfilledByVendor     User?             @relation("FulfilledRequests", fields: [fulfilledByVendorId], references: [id])
  fulfilledAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  interests             RequestInterest[]
  chatThreads           ChatThread[]
  messagesAsAttachment  Message[]         @relation("TaggedRequests")

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([fulfilledByVendorId])
}

model RequestInterest {
  id          String   @id @default(uuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendorId    String
  vendor      User     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([requestId, vendorId])
  @@index([requestId])
  @@index([vendorId])
  @@index([createdAt])
}

model ChatThread {
  id               String       @id @default(uuid())
  requestId        String
  request          Request      @relation(fields: [requestId], references: [id], onDelete: Cascade)
  creatorId        String
  creator          User         @relation("UserThreads", fields: [creatorId], references: [id], onDelete: Cascade)
  vendorId         String
  vendor           User         @relation("VendorThreads", fields: [vendorId], references: [id], onDelete: Cascade)
  lastMessageText  String?
  lastMessageAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  messages         Message[]

  @@unique([requestId, vendorId])
  @@index([creatorId, updatedAt])
  @@index([vendorId, updatedAt])
  @@index([requestId])
  @@index([createdAt])
}

model Message {
  id                 String       @id @default(uuid())
  threadId           String
  thread             ChatThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId           String
  sender             User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text               String
  imageUrl           String?
  videoUrl           String?
  type               MessageType  @default(TEXT)
  isSystem           Boolean      @default(false)
  isDeleted          Boolean      @default(false)
  taggedRequestId    String?
  taggedRequest      Request?     @relation("TaggedRequests", fields: [taggedRequestId], references: [id], onDelete: SetNull)
  // Snapshot of the vendor's inventory item as it was offered, so the chat keeps it after edits or deletion
  inventoryItem      Json?
  replyToMessageId   String?
  replyToMessage     Message?     @relation("ReplyRelation", fields: [replyToMessageId], references: [id])
  replies            Message[]    @relation("ReplyRelation")
  replyToSenderName  String?
  replyToText        String?
  readBy             String[]     @default([])
  createdAt          DateTime     @default(now())

  @@index([threadId, createdAt])
  @@index([senderId])
  @@index([createdAt])
  @@index([taggedRequestId])
}

model InventoryItem {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  rawInput    String
  imageUrls   String[] @default([])
  // Whole naira, read from the vendor's own text; null only on items saved before prices were required
  price       Int?
  brand       String?
  model       String?
  storage     String?
  condition   String?
  color       String?
  others      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([brand, model])
  @@index([title])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Subscription {
  id                       String                    @id @default(uuid())
  userId                   String                    @unique
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bachsSubscriptionId      String?                   @unique
  bachsCustomerId          String?
  bachsProductId           String?
  paystackSubscriptionCode String?                   @unique
  paystackCustomerCode     String?
  paystackPlanCode         String?
  paystackEmailToken       String?
  plan                     String                    // "monthly", "quarterly", "yearly"
  status                   String                    @default("active") // "active", "past_due", "canceled", "expired", "free"
  amount                   Float
  currency                 String                    @default("NGN")
  interval                 String                    // "month", "quarter", "year"
  currentPeriodStart       DateTime                  @default(now())
  currentPeriodEnd         DateTime
  cancelAtPeriodEnd        Boolean                   @default(false)
  canceledAt               DateTime?
  reminderSentAt           DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  transactions             SubscriptionTransaction[]

  @@index([userId])
  @@index([status, currentPeriodEnd])
}

model SubscriptionTransaction {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId        String?
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  bachsPaymentId        String?
  bachsCheckoutId       String?
  paystackReference     String?
  paystackTransactionId String?
  amount                Float
  currency              String        @default("NGN")
  status                String        // "PENDING", "SUCCESS", "FAILED"
  paymentMethod         String?
  description           String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status, createdAt])
  @@index([createdAt])
}

model BlockedVendor {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("BlocksInitiated", fields: [userId], references: [id], onDelete: Cascade)
  vendorId  String
  vendor    User     @relation("BlocksReceived", fields: [vendorId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, vendorId])
  @@index([userId])
  @@index([vendorId])
}

// Fizco staff who sign in to the admin panel. Accounts are created by a seed script, never by signup
model Admin {
  id                  String    @id @default(uuid())
  email               String    @unique
  fullName            String
  passwordHash        String
  // Sessions issued before this are rejected, so a password reset signs every device out
  passwordChangedAt   DateTime  @default(now())
  // SHA-256 of the emailed reset token; the token itself is never stored
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
